{
  "$description": "zeromark style tokens. Light is measured from zeromark.io (2026-11-01); dark is derived. Same values as assets/zeromark.css.",
  "font": {
    "sans": "\"Space Grotesk\", \"Segoe UI\", system-ui, -apple-system, sans-serif",
    "mono": "\"IBM Plex Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
    "googleFontsHref": "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;700&display=swap"
  },
  "radius": { "xs": 4, "sm": 7, "md": 10, "lg": 14, "pill": 999 },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48 },
  "tracking": { "display": "-0.03em", "label": "0.12em" },
  "motion": { "ease": "cubic-bezier(.2,.7,.2,1)", "fast": "140ms", "rise": "600ms" },
  "light": {
    "paper": "#faf7f0", "card": "#fffdf8", "sunken": "#f3efe6", "border": "#e7e0d3",
    "ink": "#1c1917", "soft": "#44403c", "muted": "#716a65", "faint": "#a8a29e",
    "flame": "#f0472c", "flameDark": "#d13a22", "flameFill": "#d63c22", "onFlame": "#ffffff",
    "series": ["#f0472c", "#2f6f4f", "#4a76a8", "#c9a063", "#a77bd0", "#57534e"],
    "sequential": ["#fdf0ea", "#f9c9b8", "#f49a80", "#f0472c", "#b8301a"],
    "diverging": ["#2f6f4f", "#8fb59d", "#efe9dd", "#f49a80", "#d13a22"],
    "status": {
      "ok":   { "fg": "#2f6f4f", "bg": "#eef3ec", "border": "#a8b9a6" },
      "warn": { "fg": "#8a6528", "bg": "#f7efe0", "border": "#d9c08f" },
      "bad":  { "fg": "#c2341d", "bg": "#fdf0ea", "border": "#eaa898" },
      "info": { "fg": "#35597f", "bg": "#eef1f4", "border": "#aebdcc" }
    },
    "grid": "#ece6da"
  },
  "dark": {
    "paper": "#171513", "card": "#1f1c19", "sunken": "#262220", "border": "#3a342e",
    "ink": "#f6f2ea", "soft": "#d6cfc4", "muted": "#a39a8f", "faint": "#6f675f",
    "flame": "#ff5a3c", "flameDark": "#ff7a60", "flameFill": "#ff5a3c", "onFlame": "#171513",
    "series": ["#ff5a3c", "#5fae84", "#7aa3d4", "#d9b276", "#b993e0", "#a8a29e"],
    "sequential": ["#3a2420", "#6e3324", "#a8432c", "#ff5a3c", "#ff9c86"],
    "diverging": ["#5fae84", "#3d6b52", "#3a342e", "#a8432c", "#ff7a60"],
    "status": {
      "ok":   { "fg": "#7cc49c", "bg": "rgba(95,174,132,.14)", "border": "rgba(95,174,132,.4)" },
      "warn": { "fg": "#e2bf7f", "bg": "rgba(217,178,118,.14)", "border": "rgba(217,178,118,.4)" },
      "bad":  { "fg": "#ff8a73", "bg": "rgba(255,90,60,.14)", "border": "rgba(255,90,60,.4)" },
      "info": { "fg": "#9cbde3", "bg": "rgba(122,163,212,.14)", "border": "rgba(122,163,212,.4)" }
    },
    "grid": "#2c2824"
  }
}
